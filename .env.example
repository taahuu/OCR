# Copy to .env and adjust. No API keys are needed.

# --- Application ---
APP_NAME=OCR Document Extraction API
ENVIRONMENT=development          # development | testing | production
LOG_LEVEL=INFO

# --- Upload / document limits ---
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=50
MAX_IMAGE_PIXELS=50000000        # total pixels (width x height)
MAX_IMAGE_DIMENSION=12000        # max width or height in pixels
MAX_RENDER_PIXELS=50000000       # cap for a rendered PDF page (DPI is lowered if exceeded)

# --- OCR ---
OCR_LANGUAGE=eng                 # e.g. eng, eng+deu (language packs must be installed)
TESSERACT_CMD=                   # only if tesseract is not on PATH, e.g.
                                 # Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CONFIG=--psm 3
OCR_TIMEOUT_SECONDS=60           # per Tesseract call
DOCUMENT_TIMEOUT_SECONDS=300     # whole document
RENDER_DPI=300                   # PDF render resolution for scanned pages
OCR_MODE=auto                    # auto | force (always OCR PDFs) | never (native text only)
NATIVE_TEXT_MIN_CHARS=25         # PDF page with at least this much text skips OCR (auto mode)

# --- Concurrency ---
MAX_CONCURRENT_OCR=2             # documents OCR'd at the same time
QUEUE_TIMEOUT_SECONDS=30         # wait for a free slot before answering 503
TESSERACT_OMP_THREAD_LIMIT=1

# --- Preprocessing ---
PREPROCESSING_ENABLED=true
LOW_CONFIDENCE_THRESHOLD=70      # retry with preprocessing below this mean confidence
PREPROCESS_MIN_LONG_SIDE=1500    # upscale smaller images up to this long side
